<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launch agent that runs archive-sessions.sh every day at 22:00 (or on
  wake, if the Mac slept through it). Replace the two paths, then:
    cp claude-session-archive.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/claude-session-archive.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>claude-session-archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PATH/TO/archive-sessions.sh</string>
    <string>/PATH/TO/ARCHIVE</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
